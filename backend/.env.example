# LUMIERE AI Backend Environment Variables

# Database
DATABASE_URL=sqlite:///./lumiere.db
# Production: postgresql://user:pass@host:5432/lumiere

# JWT Secret (change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-me

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ===========================================
# AI Generation APIs
# ===========================================

# MiniMax/Hailuo API (PRIORITY: cheapest for video ≤10s and images)
# Get your key at: https://platform.minimax.chat
MINIMAX_API_KEY=your-minimax-api-key-here

# Grok/xAI API (for video 10-15s, includes audio)
# Get your key at: https://x.ai/api
GROK_API_KEY=xai-your-api-key-here

# BytePlus ModelArk API (for video >15s or 21:9 cinema format)
# Get your keys at: https://console.byteplus.com
BYTEPLUS_ACCESS_KEY=your-access-key-here
BYTEPLUS_SECRET_KEY=your-secret-key-here

# Stability AI (for image generation - Seedream models)
# Get your key at: https://platform.stability.ai/account/keys
STABILITY_API_KEY=sk-your-stability-api-key

# ===========================================
# Payments (Stripe)
# ===========================================

# Stripe API Keys
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ===========================================
# Optional Services
# ===========================================

# Redis (for task queue, optional)
# REDIS_URL=redis://localhost:6379

# AWS S3 (for storing generated content)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=lumiere-ai-assets
# AWS_REGION=us-east-1
